{
  "name": "phaser-typescript-template",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --testTimeout=30000",
    "test:e2e": "playwright test",
    "playtest:long": "rolldown scripts/playtest.ts --platform node --format esm --log-level warn --file node_modules/.cache/scripts/playtest.mjs && node node_modules/.cache/scripts/playtest.mjs days=120 from=40 to=50",
    "generate-logo:android": "npx @capacitor/assets generate --android",
    "generate-logo:ios": "npx @capacitor/assets generate --ios",
    "deploy:android": "npm run generate-logo:android && npm run build && cap run android",
    "deploy:ios": "npm run generate-logo:ios && npm run build && cap run ios",
    "eslint": "eslint .",
    "prettier": "prettier --config .prettierrc --check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "8.3.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/cli": "8.3.1",
    "@capacitor/core": "8.3.1",
    "@capacitor/ios": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "es6-promise-plugin": "4.2.2",
    "i18n-for-browser": "3.0.0",
    "phaser": "4.1.0",
    "phaser4-rex-plugins": "4.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.0.10"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "25.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "typescript-eslint": "8.59.2",
    "vitest": "5.0.3"
  }
}
